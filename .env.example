# Copy to .env and fill in your values
# Never commit .env to version control

# PostgreSQL
POSTGRES_USER=gldt
POSTGRES_PASSWORD=gldt_secret
POSTGRES_DB=gdelt_risk
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Derived (auto-built from above in config.yaml)
DATABASE_SYNC_URL=postgresql://gldt:gldt_secret@localhost:5432/gdelt_risk

# Neo4j (graph DB). Local dev: Neo4j Desktop instance (neo4j://127.0.0.1:7687).
# Prod: docker/docker-compose.yml `neo4j` service (bolt://neo4j:7687 from other
# containers, bolt://localhost:7687 from the host).
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me
NEO4J_URI=neo4j://127.0.0.1:7687

# Ollama (optional)
OLLAMA_URL=http://localhost:11434

# Model path
MODEL_PATH=models/checkpoints/run_phase1_best.pt

# Log level
LOG_LEVEL=INFO
