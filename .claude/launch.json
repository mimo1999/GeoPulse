{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "geopulse-backend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "backend.main:app", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "geopulse-streamlit",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "streamlit", "run", "streamlit_app/app.py", "--server.port", "8502", "--server.headless", "true", "--server.address", "localhost"],
      "port": 8502,
      "env": {
        "BACKEND_URL": "http://localhost:8000"
      }
    }
  ]
}
